{
  "manifest_version": 3,
  "name": "Homestuck Annotator",
  "version": "0.2.0",
  "description": "Annotate homestuck.com pages and pass notebooks around with other readers.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.homestuck.com/*", "https://homestuck.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.homestuck.com/*", "https://homestuck.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hs-annotator@example.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
